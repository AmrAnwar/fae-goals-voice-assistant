# ---------------------------------------------------------------- LiveKit
# The local dev server (`livekit-server --dev`) uses these exact credentials.
# To use LiveKit Cloud instead, replace all three with your project values.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional: URL the browser should use, if different from LIVEKIT_URL.
# PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ------------------------------------------------------------------ Google
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key

# Optional tuning
# GOOGLE_LIVE_MODEL=gemini-3.8-live
# FAIRY_VOICE=Aoede
# FAIRY_ROOM=fairy-goals
# GOALS_DB=data/goals.db
# Cheap text model(s) for scheduled notes (not the realtime voice model).
# Comma-separated; tried cheapest first. FAIRY_NOTE_ATTEMPTS tunes retries.
# FAIRY_NOTE_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash

# ---------------------------------------------------------------- Temporal
# Local Temporal frontend/UI exposed by scripts/temporal-up.sh.
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=fairy-goals

# Daily check-in schedule (cron + IANA time zone).
TEMPORAL_SCHEDULE_ID=fairy-daily-check-in
TEMPORAL_SCHEDULE_CRON=0 9 * * *
TEMPORAL_SCHEDULE_TZ=UTC
