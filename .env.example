# ---------------------------------------------------------------- LiveKit
# The local dev server (`livekit-server --dev`) uses these exact credentials.
# To use LiveKit Cloud instead, replace all three with your project values.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional: URL the browser should use, if different from LIVEKIT_URL.
# PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ------------------------------------------------------------------ Google
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key

# Optional tuning
# GOOGLE_LIVE_MODEL=gemini-3.8-live
# FAIRY_VOICE=Aoede
# FAIRY_ROOM=fairy-goals
# GOALS_DB=data/goals.db
